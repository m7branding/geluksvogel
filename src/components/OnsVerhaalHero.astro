---
import homepage from "../data/onsverhaal.json";

interface Props {
  /** Bovenkop. GeluksVogel */
  eyebrow?: string;
  /** Titel. Ons verhaal */
  headline?: string;
}

const {
  eyebrow = homepage.hero.eyebrow,
  headline = homepage.hero.headline,
} = Astro.props;

---
<section class="page-hero">
  <div class="wrap">
    <p data-cms="onsverhaal.hero.eyebrow" class="eyebrow">{eyebrow}</p>
    <h1 data-cms="onsverhaal.hero.headline">{headline}</h1>
  </div>
</section>
