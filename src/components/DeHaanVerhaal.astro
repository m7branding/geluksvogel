---
import homepage from "../data/de-haan.json";

interface Props {
  /** Subtitel. Van ei tot volwassen haan */
  subheading?: string;
  /** Tekst. Voor elke hen die bij GeluksVogel rondscharrelt wordt ook een haan grootgebracht. Onze hanen komen u */
  paragraph?: string;
  /** Tekst 2. Meerdere keren per dag is er controle of het goed met ze gaat. Elke week worden ze gewogen om het we */
  paragraph2?: string;
  /** Tekst 3. De kippenkar wordt elke week verplaatst naar een vers stuk gras met daarin klaver, kruiden en insect */
  paragraph3?: string;
  /** Tekst 4. De hanen genieten lang in alle vrijheid van een zorgeloos leven. Pas als ze volwassen zijn komt hun  */
  paragraph4?: string;
  /** Subtitel 2. GeluksVogel hanen */
  subheading2?: string;
  /** Tekst 5. Als er kuikens uit eieren komen zijn er gemiddeld net zoveel hanen als hennen. */
  paragraph5?: string;
  /** Tekst 6. Vroeger hadden kippen een dubbel doel: de hennen om eieren te leggen en de hanen voor het vlees. Teg */
  paragraph6?: string;
  /** Tekst 7. Deze haankuikens worden in bijna alle gevallen meteen opgeruimd en vaak ook nog op dieronvriendelijk */
  paragraph7?: string;
  /** Tekst 8. Bij de hennen die eieren leggen lopen ook altijd enkele hanen, maar er komen uit de bebroede eieren  */
  paragraph8?: string;
  /** Subtitel 3. Vlees */
  subheading3?: string;
  /** Tekst 9. Het vlees van deze hanen is uniek van smaak omdat ze langzaam zijn gegroeid, veel beweging hebben ge */
  paragraph9?: string;
  /** Subtitel 4. Wist je dat … */
  subheading4?: string;
  /** Weetje. … een ‘traditionele’ vleeskip maar 6 weken leeft voordat hij/zij naar de slacht gaat, dat is maar 42 */
  fact?: string;
  /** Weetje 2. Voor een scharrelkip is dat tussen de 56 en 63 dagen. En een biologische vleeskip leeft 81 dagen, of */
  fact2?: string;
  /** Weetje 3. De Broederhaan die in een mobiele kippenkar woont mag minstens 14 weken leven! */
  fact3?: string;
  /** Linktekst. Bekijk onze hanensoep */
  linkLabel?: string;
  /** Link. /producten/#vlees */
  href?: string;
}

const {
  subheading = homepage.verhaal.subheading,
  paragraph = homepage.verhaal.paragraph,
  paragraph2 = homepage.verhaal.paragraph2,
  paragraph3 = homepage.verhaal.paragraph3,
  paragraph4 = homepage.verhaal.paragraph4,
  subheading2 = homepage.verhaal.subheading2,
  paragraph5 = homepage.verhaal.paragraph5,
  paragraph6 = homepage.verhaal.paragraph6,
  paragraph7 = homepage.verhaal.paragraph7,
  paragraph8 = homepage.verhaal.paragraph8,
  subheading3 = homepage.verhaal.subheading3,
  paragraph9 = homepage.verhaal.paragraph9,
  subheading4 = homepage.verhaal.subheading4,
  fact = homepage.verhaal.fact,
  fact2 = homepage.verhaal.fact2,
  fact3 = homepage.verhaal.fact3,
  linkLabel = homepage.verhaal.linkLabel,
  href = homepage.verhaal.href,
} = Astro.props;

---
<section class="section bg-sand">
  <div class="wrap">
    <div class="columns-2 reveal">
      <h3 data-cms="de-haan.verhaal.subheading">{subheading}</h3>
      <p data-cms="de-haan.verhaal.paragraph">{paragraph}</p>
      <p data-cms="de-haan.verhaal.paragraph2">{paragraph2}</p>
      <p data-cms="de-haan.verhaal.paragraph3">{paragraph3}</p>
      <p data-cms="de-haan.verhaal.paragraph4">{paragraph4}</p>
      <h3 data-cms="de-haan.verhaal.subheading2">{subheading2}</h3>
      <p data-cms="de-haan.verhaal.paragraph5">{paragraph5}</p>
      <p data-cms="de-haan.verhaal.paragraph6">{paragraph6}</p>
      <p data-cms="de-haan.verhaal.paragraph7">{paragraph7}</p>
      <p data-cms="de-haan.verhaal.paragraph8">{paragraph8}</p>
      <h3 data-cms="de-haan.verhaal.subheading3">{subheading3}</h3>
      <p data-cms="de-haan.verhaal.paragraph9">{paragraph9}</p>
      <div class="facts">
        <h3 data-cms="de-haan.verhaal.subheading4">{subheading4}</h3>
        <p data-cms="de-haan.verhaal.fact">{fact}</p>
        <p data-cms="de-haan.verhaal.fact2">{fact2}</p>
        <p data-cms="de-haan.verhaal.fact3">{fact3}</p>
      </div>
    </div>
    <p class="back-link"><a class="text-link" href={href}><span data-cms="de-haan.verhaal.linkLabel">{linkLabel}</span> <svg class="arrow" viewBox="0 0 52 14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M0 7h50M44 1l6 6-6 6"/></svg></a></p>
  </div>
</section>
