---
import homepage from "../data/recepten.json";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  /** Het recept. */
  entry: CollectionEntry<"recepten">;
  /** Bovenkop. Recepten */
  eyebrow?: string;
  /** Kop ingrediënten. Ingrediënten */
  ingredientsLabel?: string;
  /** Kop bereidingswijze. Bereidingswijze */
  stepsLabel?: string;
  /** Linktekst. Alle recepten */
  linkLabel?: string;
  /** Link. /recepten/ */
  href?: string;
}

const {
  eyebrow = homepage.detail.eyebrow,
  ingredientsLabel = homepage.detail.ingredientsLabel,
  stepsLabel = homepage.detail.stepsLabel,
  linkLabel = homepage.detail.linkLabel,
  href = homepage.detail.href,
  entry,
} = Astro.props;
const { Content } = await render(entry);
---
<article class="section">
  <div class="wrap recipe">
    <div class="recipe-body">
      <a data-cms="recepten.detail.eyebrow" class="eyebrow" href={href}>{eyebrow}</a>
      <h1>{entry.data.title}</h1>
      <h2 data-cms="recepten.detail.ingredientsLabel">{ingredientsLabel}</h2>
      <ul class="ingredients">
        {entry.data.ingredients.map((ingredient) => <li>{ingredient}</li>)}
      </ul>
      <h2 data-cms="recepten.detail.stepsLabel">{stepsLabel}</h2>
      <div class="steps"><Content /></div>
      <p class="back-link"><a class="text-link" href={href}><svg class="arrow" viewBox="0 0 52 14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M52 7H2M8 1 2 7l6 6"/></svg> <span data-cms="recepten.detail.linkLabel">{linkLabel}</span></a></p>
    </div>
    <figure class="recipe-media"><img src={entry.data.image} alt={entry.data.imageAlt} width="684" height="1024" fetchpriority="high"></figure>
  </div>
</article>
