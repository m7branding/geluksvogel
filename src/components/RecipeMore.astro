---
import homepage from "../data/recepten.json";
import { getCollection } from "astro:content";

interface Props {
  /** Het recept dat nu open staat. */
  current: string;
  /** Bovenkop. Recepten */
  eyebrow?: string;
  /** Titel meer. Meer GeluksVogel recepten */
  moreHeadline?: string;
}

const {
  eyebrow = homepage.detail.eyebrow,
  moreHeadline = homepage.detail.moreHeadline,
  current,
} = Astro.props;
const all = (await getCollection("recepten")).sort((a, b) => b.data.order - a.data.order);
const at = all.findIndex((recipe) => recipe.id === current);
// The next three in the list, wrapping around, so every recipe links onwards.
const others = [1, 2, 3].map((step) => all[(at + step) % all.length]).filter((recipe) => recipe.id !== current);
---
<section class="section bg-cream">
  <div class="wrap">
    <div class="section-head center"><h2 data-cms="recepten.detail.moreHeadline" class="section-title">{moreHeadline}</h2></div>
    <ul class="cards cols-3">
      {others.map((recipe) => (
        <li class="reveal"><a class="card" href={`/${recipe.id}/`}><div class="media"><img src={recipe.data.image} alt={recipe.data.imageAlt} width="684" height="1024" loading="lazy"></div><span data-cms="recepten.detail.eyebrow" class="cat">{eyebrow}</span><h3>{recipe.data.title}</h3></a></li>
      ))}
    </ul>
  </div>
</section>
