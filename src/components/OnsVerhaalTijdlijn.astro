---
<section class="section bg-cream" data-slider>
  <div class="wrap">
    <div class="timeline-head">
      <h2 data-cms="onsverhaal.tijdlijn.headline">{headline}</h2>
      <div class="slider-buttons">
        <button type="button" data-prev aria-label={prevLabel}><svg viewBox="0 0 22 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M22 6H2M7 1 2 6l5 5"/></svg></button>
        <button type="button" data-next aria-label={nextLabel}><svg viewBox="0 0 22 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 6h20M15 1l5 5-5 5"/></svg></button>
      </div>
    </div>
    <ol class="timeline" data-track tabindex="0" aria-label={headline}>
      <li><div class="media contain"><img data-cms="onsverhaal.tijdlijn.image" src={image} alt={imageAlt} width="480" height="320" loading="lazy"></div><span class="dot" aria-hidden="true"></span><time data-cms="onsverhaal.tijdlijn.date">{date}</time><h3 data-cms="onsverhaal.tijdlijn.title">{title}</h3></li>
      <li><div class="media"><img data-cms="onsverhaal.tijdlijn.image2" src={image2} alt={imageAlt2} width="480" height="320" loading="lazy"></div><span class="dot" aria-hidden="true"></span><time data-cms="onsverhaal.tijdlijn.date2">{date2}</time><h3 data-cms="onsverhaal.tijdlijn.title2">{title2}</h3></li>
